# Copier ce fichier en .env.local puis compléter.
# Clé secrète Supabase (Project Settings > API Keys > Secret keys).
# Ne jamais la partager ni la mettre dans le code : elle donne un accès complet à la base.
SUPABASE_SECRET_KEY=

# Facultatif : déjà renseignés par défaut dans lib/supabase/config.ts
# NEXT_PUBLIC_SUPABASE_URL=https://yluwmhfalzmjnhykpzkj.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Récapitulatif hebdomadaire des alertes par e-mail (voir vercel.json et app/api/alertes/route.ts)
# CRON_SECRET : chaîne aléatoire longue, transmise par Vercel au planificateur.
# RESEND_API_KEY : clé du service d'envoi d'e-mails Resend (resend.com).
# ALERTES_EXPEDITEUR : adresse d'expédition vérifiée chez Resend, ex. Frisk DU <alertes@votre-domaine.fr>
# URL_APPLICATION : adresse publique de Frisk DU, pour les liens des e-mails.
CRON_SECRET=
RESEND_API_KEY=
ALERTES_EXPEDITEUR=
URL_APPLICATION=

# Protection anti-robot (Cloudflare Turnstile) de l'inscription et de la connexion : voir le README.
# Clé du site, publique. Sans elle, aucune vérification n'est affichée.
# Pour les essais en local : 1x00000000000000000000AA (clé de test Cloudflare, toujours acceptée).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Paiement en ligne (voir le README, section Stripe).
# STRIPE_SECRET_KEY : clé secrète Stripe (sk_test_... en mode test).
# STRIPE_WEBHOOK_SECRET : secret de signature du webhook (whsec_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
